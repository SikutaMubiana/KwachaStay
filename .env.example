# KwachaStay — Environment Variables
# Copy this file to .env and fill in your real values

# Flask
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key
BOOKING_REQUEST_EXPIRY_HOURS=24

# Flutterwave hosted checkout for Zambian mobile money (MTN/Airtel)
# The provider lets the guest choose the supported network at checkout.
# Set PUBLIC_BASE_URL to the canonical public HTTPS site URL (payment redirects use its callback path).
# Configure the Flutterwave webhook URL as PUBLIC_BASE_URL/webhooks/flutterwave and use the same secret hash below.
# Get keys from https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_HASH=replace-with-your-flutterwave-webhook-secret-hash
PUBLIC_BASE_URL=https://your-public-https-domain.example

# Supabase PostgreSQL and Storage (production)
DATABASE_URL=postgresql://postgres.project-ref:replace-with-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
STORAGE_BACKEND=supabase
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PROJECT_REF=project-ref
# Optional: personal access token for scripts/stage_supabase.py (server only, never commit).
SUPABASE_ACCESS_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=property-images

# Optional manual bank-transfer collection instructions.
# The guest payment flow is enabled only when the bank name, account name, and account number are set.
# Configure details for a KwachaStay-controlled merchant account; never use a host's personal account.
# Transfers stay pending until an administrator checks the bank statement and records the verified reference.
# This option does not connect to a bank API or automatically reconcile deposits.
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_BRANCH=
BANK_TRANSFER_SWIFT_CODE=

# Optional email (SMTP, e.g. Gmail App Password, for password resets and booking notifications)
# Get app password: Google Account → Security → 2-Step Verification → App Passwords
EMAIL_PROVIDER=smtp
PASSWORD_RESET_TTL_SECONDS=3600
EMAIL_WEBHOOK_MAX_AGE_SECONDS=300
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=KwachaStay <no-reply@your-domain.example>

# Optional phone verification (Twilio Programmable Messaging)
# Phone numbers are only marked verified after the guest confirms a one-time SMS code.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_FROM_NUMBER=+15005550006
